# Copie este arquivo para .env e preencha os valores

# PostgreSQL — no Railway/Render é gerado automaticamente
DATABASE_URL="postgresql://user:password@localhost:5432/fincontrol"

# JWT — gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="troque-por-uma-string-aleatoria-longa-aqui"

# URL do frontend (para CORS) — em produção coloque o domínio exato
FRONTEND_URL="http://localhost:5173"

# Porta (Render/Railway definem automaticamente)
PORT=3333

# Ambiente
NODE_ENV="development"
